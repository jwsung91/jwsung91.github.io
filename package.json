{
  "name": "jwsung91.github.io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:content": "prettier \"src/content/**/*.{md,mdx}\" \"public/admin/config.yml\" --write",
    "format:site": "prettier \"src/**/*.{astro,ts,js,json}\" \"*.{json,yml,md}\" \".github/**/*.yml\" --write",
    "lint:md": "markdownlint-cli2",
    "content:check": "node scripts/check-content.mjs",
    "content:fix": "node scripts/check-content.mjs --fix && npm run format:content",
    "fix": "node scripts/check-content.mjs --fix && markdownlint-cli2 --fix && npm run format:content && npm run format:site",
    "check": "npm run format:check && npm run lint:md && npm run content:check && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-serif-kr": "^5.2.9",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.0.5",
    "mermaid": "^11.14.0",
    "pretendard": "^1.3.9",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.1",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3"
  }
}
