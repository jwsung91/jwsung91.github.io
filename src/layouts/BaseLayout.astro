---
import '../styles/global.css';
import 'pretendard/dist/web/variable/pretendardvariable.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'jwsung91.github.io',
  description = 'Robotics Software Architect. C++ · ROS 2 · Async communication systems.',
} = Astro.props;
---

<!doctype html>
<html lang="ko" class="bg-zinc-950 text-zinc-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-zinc-950 font-sans text-base leading-relaxed text-zinc-300 transition-colors duration-200">
    <Nav />
    <slot />
  </body>
</html>
