---
import '../styles/global.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '@fontsource/noto-serif-kr/korean-400.css';
import '@fontsource/noto-serif-kr/korean-600.css';
import '@fontsource/noto-serif-kr/korean-700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import Analytics from '../components/Analytics.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  title = 'jwsung91.github.io',
  description = 'Robotics Software Architect — platform architecture, middleware.',
  ogType = 'website',
  structuredData,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://jwsung91.github.io',
);
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<html
  lang="ko"
  class="bg-stone-50 text-stone-900 dark:bg-zinc-950 dark:text-stone-100"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="jwsung91"
      href="/rss.xml"
    />
    <title>{title}</title>
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="jwsung91" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <Analytics />
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <script is:inline>
      const stored =
        typeof localStorage !== 'undefined'
          ? localStorage.getItem('theme')
          : null;
      const prefersDark = window.matchMedia(
        '(prefers-color-scheme: dark)',
      ).matches;
      const isDark = stored ? stored === 'dark' : prefersDark;
      document.documentElement.classList.toggle('dark', isDark);
    </script>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd8MOf85hzMTyOEYALFuaP5Tx1XXAQvyqEply+C9nqipWqxRYVUUs5JVKdWRe"
      crossorigin="anonymous"
    />
  </head>
  <body
    class="min-h-screen bg-stone-50 font-sans text-base leading-relaxed text-stone-700 transition-colors duration-200 dark:bg-zinc-950 dark:text-stone-300"
  >
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <Nav />
    <div id="main" tabindex="-1">
      <slot />
    </div>
    <script>
      const copyIcon = `
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
      `;
      const checkIcon = `
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      `;
      const errorIcon = `
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      `;

      const setCopyButtonState = (
        button: HTMLButtonElement,
        state: 'idle' | 'copied' | 'failed',
      ) => {
        button.classList.toggle('is-copied', state === 'copied');
        button.classList.toggle('is-failed', state === 'failed');

        if (state === 'copied') {
          button.innerHTML = checkIcon;
          button.setAttribute('aria-label', 'Code copied to clipboard');
          button.title = 'Copied';
          return;
        }

        if (state === 'failed') {
          button.innerHTML = errorIcon;
          button.setAttribute('aria-label', 'Failed to copy code');
          button.title = 'Failed to copy';
          return;
        }

        button.innerHTML = copyIcon;
        button.setAttribute('aria-label', 'Copy code to clipboard');
        button.title = 'Copy code';
      };

      const copyText = async (text: string) => {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return;
        }

        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.top = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      };

      const enhanceCodeBlocks = () => {
        document.querySelectorAll('pre').forEach((pre) => {
          if (pre.parentElement?.classList.contains('code-copy-wrapper')) {
            return;
          }

          const code = pre.querySelector('code');

          if (!code) {
            return;
          }

          const wrapper = document.createElement('div');
          wrapper.className = 'code-copy-wrapper';

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'code-copy-button';
          setCopyButtonState(button, 'idle');

          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.append(pre, button);

          button.addEventListener('click', async () => {
            const text =
              code instanceof HTMLElement
                ? code.innerText
                : (code.textContent ?? '');

            try {
              await copyText(text.trimEnd());
              setCopyButtonState(button, 'copied');
            } catch {
              setCopyButtonState(button, 'failed');
            }

            window.setTimeout(() => {
              setCopyButtonState(button, 'idle');
            }, 1600);
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', enhanceCodeBlocks, {
          once: true,
        });
      } else {
        enhanceCodeBlocks();
      }
    </script>
  </body>
</html>
