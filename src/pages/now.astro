---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const nowEntry = await getEntry('now', 'now');
const { Content } = await render(nowEntry);
---

<BaseLayout title="Now — jwsung91" description="지금 무엇을 하고 있는지">
  <main class="mx-auto max-w-2xl px-6 py-16 md:px-8">
    <div class="mb-10">
      <p class="mb-2 font-mono text-sm text-zinc-500"><a href="/" class="hover:underline">jwsung91</a> / now</p>
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100">Now</h1>
      {nowEntry.data.updatedAt && (
        <p class="mt-2 font-mono text-sm text-zinc-500">업데이트: {nowEntry.data.updatedAt}</p>
      )}
    </div>

    <div class="prose dark:prose-invert prose-zinc max-w-none prose-headings:font-mono prose-headings:text-xs prose-headings:uppercase prose-headings:tracking-wider prose-headings:text-zinc-500 prose-p:text-zinc-700 dark:prose-p:text-zinc-300 prose-li:text-zinc-700 dark:prose-li:text-zinc-300">
      <Content />
    </div>
  </main>
</BaseLayout>
