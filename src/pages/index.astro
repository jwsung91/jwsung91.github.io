---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import PostMetaBadges from '../components/PostMetaBadges.astro';
import { formatDate, getBlogPath, sortBlogPosts } from '../lib/blog';
import { getProjectPath, sortProjects } from '../lib/projects';

const projects = sortProjects(await getCollection('projects'));
const recentPosts = sortBlogPosts(
  await getCollection('blog', ({ data }) => !data.draft),
).slice(0, 3);
const nowEntry = await getEntry('now', 'now');
const { Content: NowContent } = await render(nowEntry);

const statusLabel: Record<string, string> = {
  active: 'active',
  wip: 'wip',
  archived: 'archived',
};
---

<BaseLayout
  title="jwsung91"
  description="Robotics Software Architect — platform architecture, middleware."
>
  <main class="page-layout">
    <section class="mb-16">
      <p class="mb-2 font-mono text-sm text-zinc-500">jwsung91.github.io</p>
      <h1
        class="mb-3 text-3xl font-bold text-zinc-900 dark:text-zinc-100 md:text-4xl"
      >
        Jinwoo Sung
      </h1>
      <p
        class="max-w-xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400"
      >
        Robotics Software Architect — platform architecture, middleware.
      </p>
    </section>

    <section id="now" class="mb-16">
      <h2 class="mb-6 font-mono text-xs uppercase tracking-wider text-zinc-500">
        Now
      </h2>

      <div
        class="page-content prose dark:prose-invert prose-zinc max-w-none prose-headings:text-xs prose-headings:uppercase prose-headings:tracking-wider prose-headings:text-zinc-500 prose-p:text-zinc-700 dark:prose-p:text-zinc-300 prose-li:text-zinc-700 dark:prose-li:text-zinc-300"
      >
        <NowContent />
      </div>
      <div class="mt-6 flex items-center gap-4">
        {
          nowEntry.data.updatedAt && (
            <span class="text-sm text-zinc-500 dark:text-zinc-600">
              마지막 업데이트: {nowEntry.data.updatedAt}
            </span>
          )
        }
        <a href="/now" class="font-mono text-sm text-blue-400 hover:underline"
          >more →</a
        >
      </div>
    </section>

    <section id="projects" class="mb-16">
      <h2 class="mb-6 font-mono text-xs uppercase tracking-wider text-zinc-500">
        Projects
      </h2>
      <ul class="space-y-4">
        {
          projects.map((p) => (
            <li class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-100/50 dark:bg-zinc-900/50 p-5">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <span class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">
                      {p.data.title}
                    </span>
                    <span
                      class={`rounded px-2 py-1 font-mono text-xs uppercase tracking-wider ${
                        p.data.status === 'active'
                          ? 'bg-blue-100/50 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300'
                          : p.data.status === 'wip'
                            ? 'bg-amber-100/50 text-amber-700 dark:bg-amber-900/50 dark:text-amber-300'
                            : 'bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400'
                      }`}
                    >
                      {statusLabel[p.data.status]}
                    </span>
                  </div>
                  <p class="text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
                    {p.data.description}
                  </p>
                  <a
                    href={getProjectPath(p)}
                    class="mt-3 inline-block font-mono text-sm text-blue-400 hover:underline"
                  >
                    project docs →
                  </a>
                </div>

                <div class="flex gap-4 text-sm font-mono">
                  {p.data.url && (
                    <a href={p.data.url} class="text-blue-400 hover:underline">
                      docs
                    </a>
                  )}
                  {p.data.repo && (
                    <a href={p.data.repo} class="text-blue-400 hover:underline">
                      repo
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-16">
      <h2 class="mb-6 font-mono text-xs uppercase tracking-wider text-zinc-500">
        Recent Writing
      </h2>
      <div class="space-y-4">
        {
          recentPosts.map((post) => (
            <a
              href={getBlogPath(post)}
              class="block rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-100/50 dark:bg-zinc-900/50 p-5"
            >
              <div class="mb-3 flex flex-wrap items-center gap-3">
                <span class="font-mono text-xs uppercase tracking-wider text-zinc-500">
                  {formatDate(post.data.date)}
                </span>
                <PostMetaBadges
                  project={post.data.project}
                  kind={post.data.kind}
                  topic={post.data.topic}
                />
              </div>
              <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 transition-colors duration-200 hover:text-zinc-700 dark:hover:text-zinc-300">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="mt-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
                  {post.data.description}
                </p>
              )}
            </a>
          ))
        }
      </div>
      <a
        href="/blog"
        class="mt-6 inline-block font-mono text-sm text-blue-400 hover:underline"
      >
        all posts →
      </a>
    </section>
  </main>
</BaseLayout>
