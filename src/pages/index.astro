---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const statusLabel: Record<string, string> = {
  active: 'active',
  wip: 'wip',
  archived: 'archived',
};
---

<BaseLayout title="jwsung91" description="Software engineer — systems, networking, and tools.">
  <!-- Hero -->
  <header class="mb-16">
    <p class="text-zinc-500 text-sm mb-3">jwsung91.github.io</p>
    <h1 class="text-2xl font-bold text-zinc-100 mb-2">Blake (Jungwon Sung)</h1>
    <p class="text-zinc-400 leading-relaxed">
      Software engineer. Systems programming, networking, and developer tooling.
    </p>
    <nav class="mt-6 flex gap-4 text-sm">
      <a href="/now" class="text-blue-400 hover:text-blue-300 transition-colors">/now</a>
      <a href="https://jwsung91.github.io/blog/" class="text-zinc-500 hover:text-zinc-300 transition-colors">/blog</a>
      <a href="https://github.com/jwsung91" class="text-zinc-500 hover:text-zinc-300 transition-colors">github</a>
    </nav>
  </header>

  <!-- Now preview -->
  <section class="mb-16">
    <h2 class="text-xs text-zinc-500 uppercase tracking-widest mb-4">Now</h2>
    <div class="border border-zinc-800 rounded p-4 text-zinc-400 text-sm leading-relaxed">
      <p>
        unilink 라이브러리 개발 중. C++ 멀티플랫폼 통신 추상화.
      </p>
      <a href="/now" class="mt-3 inline-block text-blue-400 hover:text-blue-300 text-xs transition-colors">
        more →
      </a>
    </div>
  </section>

  <!-- Projects -->
  <section>
    <h2 class="text-xs text-zinc-500 uppercase tracking-widest mb-4">Projects</h2>
    <ul class="space-y-4">
      {projects.map((p) => (
        <li class="border border-zinc-800 rounded p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-zinc-100 font-semibold">{p.data.title}</span>
                <span class={`text-xs px-1.5 py-0.5 rounded ${
                  p.data.status === 'active'
                    ? 'bg-blue-900/50 text-blue-400'
                    : p.data.status === 'wip'
                    ? 'bg-yellow-900/50 text-yellow-400'
                    : 'bg-zinc-800 text-zinc-500'
                }`}>
                  {statusLabel[p.data.status]}
                </span>
              </div>
              <p class="text-zinc-400 text-sm">{p.data.description}</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {p.data.tags.map((tag) => (
                  <span class="text-xs text-zinc-500">#{tag}</span>
                ))}
              </div>
            </div>
            <div class="flex gap-3 text-xs shrink-0">
              {p.data.url && (
                <a href={p.data.url} class="text-blue-400 hover:text-blue-300 transition-colors">docs</a>
              )}
              {p.data.repo && (
                <a href={p.data.repo} class="text-zinc-500 hover:text-zinc-300 transition-colors">repo</a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
