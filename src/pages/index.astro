---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import PostListItem from '../components/PostListItem.astro';
import { formatDate, getPublishedBlogPosts } from '../lib/blog';
import { getProjectPath, sortProjects } from '../lib/projects';

const projects = sortProjects(await getCollection('projects'));
const recentPosts = (await getPublishedBlogPosts()).slice(0, 3);
const nowEntry = await getEntry('now', 'now');
const { Content: NowContent } = await render(nowEntry);

const statusLabel: Record<string, string> = {
  active: 'active',
  wip: 'wip',
  archived: 'archived',
};
---

<BaseLayout
  title="jwsung91"
  description="Robotics Software Architect — platform architecture, middleware."
>
  <main class="page-layout">
    <section class="mb-16">
      <p class="mb-2 font-mono text-sm text-stone-500">jwsung91.github.io</p>
      <h1
        class="mb-3 text-3xl font-bold text-stone-900 dark:text-stone-100 md:text-4xl"
      >
        Jinwoo Sung
      </h1>
      <p
        class="max-w-xl text-base leading-relaxed text-stone-600 dark:text-stone-400"
      >
        Robotics Software Architect — platform architecture, middleware.
      </p>
    </section>

    <section id="now" class="mb-16">
      <h2 class="mb-6 section-eyebrow">Now</h2>

      <div
        class="now-content page-content prose dark:prose-invert prose-stone max-w-none prose-headings:text-xs prose-headings:uppercase prose-headings:tracking-wider prose-headings:text-stone-500 prose-p:text-stone-700 dark:prose-p:text-stone-300 prose-li:text-stone-700 dark:prose-li:text-stone-300 prose-a:text-azure-600 dark:prose-a:text-azure-400 prose-a:no-underline hover:prose-a:underline"
      >
        <NowContent />
      </div>
      <div class="mt-6 flex items-center gap-4">
        {
          nowEntry.data.updatedAt && (
            <span class="text-sm text-stone-500 dark:text-stone-600">
              마지막 업데이트: {formatDate(nowEntry.data.updatedAt)}
            </span>
          )
        }
        <a
          href="/now"
          class="font-mono text-sm text-azure-600 dark:text-azure-400 hover:underline"
          >more →</a
        >
      </div>
    </section>

    <section id="projects" class="mb-16">
      <h2 class="mb-6 section-eyebrow">Projects</h2>
      <ul class="space-y-4">
        {
          projects.map((p) => (
            <li class="rounded-lg border border-stone-200 dark:border-stone-800 bg-stone-100/50 dark:bg-stone-900/50 p-5">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <span class="text-xl font-semibold text-stone-900 dark:text-stone-100">
                      {p.data.title}
                    </span>
                    <span
                      class={`rounded px-2 py-1 font-mono text-xs uppercase tracking-wider ${
                        p.data.status === 'active'
                          ? 'bg-azure-500/15 text-azure-700 dark:bg-azure-500/15 dark:text-azure-400'
                          : p.data.status === 'wip'
                            ? 'bg-amber-100/50 text-amber-700 dark:bg-amber-900/50 dark:text-amber-300'
                            : 'bg-stone-200 dark:bg-stone-800 text-stone-600 dark:text-stone-400'
                      }`}
                    >
                      {statusLabel[p.data.status]}
                    </span>
                  </div>
                  <p class="text-base leading-relaxed text-stone-700 dark:text-stone-300">
                    {p.data.description}
                  </p>
                  <a
                    href={getProjectPath(p)}
                    class="mt-3 inline-block font-mono text-sm text-azure-600 dark:text-azure-400 hover:underline"
                  >
                    project docs →
                  </a>
                </div>

                <div class="flex gap-4 text-sm font-mono">
                  {p.data.url && (
                    <a
                      href={p.data.url}
                      class="text-azure-600 dark:text-azure-400 hover:underline"
                    >
                      docs
                    </a>
                  )}
                  {p.data.repo && (
                    <a
                      href={p.data.repo}
                      class="text-azure-600 dark:text-azure-400 hover:underline"
                    >
                      repo
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-16">
      <h2 class="mb-6 section-eyebrow">Recent Writing</h2>
      <div class="space-y-4">
        {
          recentPosts.map((post) => (
            <PostListItem post={post} variant="card" headingLevel="h3" />
          ))
        }
      </div>
      <a
        href="/blog/"
        class="mt-6 inline-block font-mono text-sm text-azure-600 dark:text-azure-400 hover:underline"
      >
        all posts →
      </a>
    </section>
  </main>
</BaseLayout>
