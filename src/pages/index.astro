---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CategoryBadge from '../components/CategoryBadge.astro';
import { formatDate, getBlogPath, sortBlogPosts } from '../lib/blog';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const recentPosts = sortBlogPosts(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 3);

const statusLabel: Record<string, string> = {
  active: 'active',
  wip: 'wip',
  archived: 'archived',
};
---

<BaseLayout title="jwsung91" description="Software engineer — systems, networking, and tools.">
  <main class="mx-auto max-w-2xl px-6 py-16 md:px-8">
    <section class="mb-16">
      <p class="mb-2 font-mono text-sm text-zinc-500">jwsung91.github.io</p>
      <h1 class="mb-3 text-3xl font-bold text-zinc-100 md:text-4xl">Jinwoo Sung</h1>
      <p class="max-w-xl text-base leading-relaxed text-zinc-400">
        Robotics Software Architect. C++ · ROS 2 · Async communication systems.
      </p>
      <div class="mt-4 flex flex-wrap gap-4 text-sm font-mono">
        <a href="/#now" class="text-blue-400 hover:underline">/now</a>
        <a href="/blog" class="text-blue-400 hover:underline">/blog</a>
        <a href="/about" class="text-blue-400 hover:underline">/about</a>
        <a href="https://github.com/jwsung91" class="text-blue-400 hover:underline">github</a>
      </div>
    </section>

    <section id="now" class="mb-16">
      <h2 class="mb-6 font-mono text-xs uppercase tracking-wider text-zinc-500">Now</h2>

      <!-- TODO: Move this section into src/content/now.md once the content layer is introduced. -->
      <div class="space-y-8">
        <div>
          <h3 class="mb-3 font-mono text-xs uppercase tracking-wider text-zinc-500">작업 중</h3>
          <ul class="space-y-2 text-zinc-300">
            <li>unilink v0.5.x — ABI 안정화, Python 바인딩 개선</li>
            <li>이 사이트 구축 (허브 + 블로그 + AI 피드 계획)</li>
          </ul>
        </div>
        <div>
          <h3 class="mb-3 font-mono text-xs uppercase tracking-wider text-zinc-500">관심 주제</h3>
          <ul class="space-y-2 text-zinc-300">
            <li>ROS 2 Zenoh 브리지</li>
            <li>C++20 coroutines과 Boost.Asio</li>
          </ul>
        </div>
        <p class="text-sm text-zinc-600">마지막 업데이트: 2026년 4월</p>
      </div>
    </section>

    <section id="projects" class="mb-16">
      <h2 class="mb-6 font-mono text-xs uppercase tracking-wider text-zinc-500">Projects</h2>
      <ul class="space-y-4">
        {projects.map((p) => (
          <li class="rounded-lg border border-zinc-800 bg-zinc-900/50 p-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <span class="text-xl font-semibold text-zinc-100">{p.data.title}</span>
                  <span class={`rounded px-2 py-1 font-mono text-xs uppercase tracking-wider ${
                    p.data.status === 'active'
                      ? 'bg-blue-900/50 text-blue-300'
                      : p.data.status === 'wip'
                        ? 'bg-amber-900/50 text-amber-300'
                        : 'bg-zinc-800 text-zinc-400'
                  }`}>
                    {statusLabel[p.data.status]}
                  </span>
                </div>
                <p class="text-base leading-relaxed text-zinc-300">{p.data.description}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {p.data.tags.map((tag) => (
                    <span class="font-mono text-xs uppercase tracking-wider text-zinc-500">#{tag}</span>
                  ))}
                </div>
              </div>

              <div class="flex gap-4 text-sm font-mono">
                {p.data.url && (
                  <a href={p.data.url} class="text-blue-400 hover:underline">docs</a>
                )}
                {p.data.repo && (
                  <a href={p.data.repo} class="text-blue-400 hover:underline">repo</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-16">
      <h2 class="mb-6 text-xl font-semibold text-zinc-100 md:text-2xl">Recent Writing</h2>
      <div class="space-y-4">
        {recentPosts.map((post) => (
          <a
            href={getBlogPath(post)}
            class="block rounded-lg border border-zinc-800 bg-zinc-900/50 p-5"
          >
            <div class="mb-3 flex flex-wrap items-center gap-3">
              <span class="font-mono text-xs uppercase tracking-wider text-zinc-500">
                {formatDate(post.data.date)}
              </span>
              <CategoryBadge category={post.data.category} />
            </div>
            <h3 class="text-xl font-semibold text-zinc-100 transition-colors duration-200 hover:text-zinc-300">
              {post.data.title}
            </h3>
            {post.data.description && (
              <p class="mt-2 text-base leading-relaxed text-zinc-400">{post.data.description}</p>
            )}
          </a>
        ))}
      </div>
      <a href="/blog" class="mt-6 inline-block font-mono text-sm text-blue-400 hover:underline">
        all posts →
      </a>
    </section>

    <section>
      <h2 class="mb-6 text-xl font-semibold text-zinc-100 md:text-2xl">Contact</h2>
      <div class="flex flex-wrap gap-4 text-sm font-mono">
        <a href="mailto:jwsung91@gmail.com" class="text-blue-400 hover:underline">email</a>
        <a href="https://www.linkedin.com/in/jwsung91/" class="text-blue-400 hover:underline">linkedin</a>
        <a href="https://github.com/jwsung91" class="text-blue-400 hover:underline">github</a>
      </div>
      <p class="mt-3 text-sm text-zinc-500">
        상세 이력은 <a href="/about" class="text-blue-400 hover:underline">/about</a>에 있습니다.
      </p>
    </section>
  </main>
</BaseLayout>
