---
import { getCollection } from 'astro:content';
import PostMetaBadges from '../../components/PostMetaBadges.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  getBlogPath,
  getProjectPosts,
  getSitePosts,
  getStudyPosts,
  sortBlogPosts,
  type BlogProject,
} from '../../lib/blog';

const allPosts = await getCollection('blog');
const posts = sortBlogPosts(
  allPosts.filter((post) => post.data.draft !== true),
);
const projectGroups = (['unilink', 'ai-curator'] as BlogProject[])
  .map((project) => ({
    project,
    posts: getProjectPosts(posts, project),
  }))
  .filter((group) => group.posts.length > 0);
const studyPosts = getStudyPosts(posts);
const sitePosts = getSitePosts(posts);
const projectDocTitles: Record<BlogProject, string> = {
  unilink: 'unilink 설계 노트',
  'ai-curator': 'AI Curator 파이프라인 구축기',
  site: 'Site Notes',
};
---

<BaseLayout
  title="Blog — jwsung91"
  description="Writing about systems, robotics, and software architecture."
>
  <main class="page-layout">
    <section class="mb-16">
      <h1
        class="mb-3 text-3xl font-bold text-stone-900 dark:text-stone-100 md:text-4xl"
      >
        Writing
      </h1>
      <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">
        프로젝트와 개인 학습을 기록하는 기술 문서 아카이브입니다.
      </p>
    </section>

    <section class="mb-16">
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Project Docs
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          projectGroups.map((group) => {
            const firstPost = group.posts[group.posts.length - 1];

            return (
              <article class="rounded-lg border border-stone-200 bg-stone-100/50 p-5 dark:border-stone-800 dark:bg-stone-900/50">
                <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-100">
                  {projectDocTitles[group.project]}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                  {group.posts.length}개의 프로젝트 문서가 있습니다.
                </p>
                <a
                  href={`/projects/${group.project}/`}
                  class="mt-4 inline-block font-mono text-sm text-coral-600 dark:text-coral-400 hover:underline"
                >
                  project docs →
                </a>
                {firstPost && (
                  <a
                    href={getBlogPath(firstPost)}
                    class="mt-2 block text-sm text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
                  >
                    시작하기: {firstPost.data.title}
                  </a>
                )}
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="mb-16">
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Study Notes
      </h2>
      {
        studyPosts.length > 0 ? (
          <ul class="space-y-3">
            {studyPosts.map((post) => (
              <li>
                <a
                  href={getBlogPath(post)}
                  class="group block rounded-lg border border-stone-200 bg-stone-100/50 p-5 dark:border-stone-800 dark:bg-stone-900/50"
                >
                  <div class="mb-3 flex flex-wrap items-center gap-3">
                    <span class="font-mono text-xs uppercase tracking-wider text-stone-500">
                      {formatDate(post.data.date)}
                    </span>
                    <PostMetaBadges
                      project={post.data.project}
                      kind={post.data.kind}
                    />
                  </div>
                  <h3 class="text-lg font-semibold text-stone-900 transition-colors duration-200 group-hover:text-stone-700 dark:text-stone-100 dark:group-hover:text-stone-300">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                    {post.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">
            공개된 study 글이 아직 없습니다.
          </p>
        )
      }
    </section>

    <section class="mb-16">
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Site Notes
      </h2>
      {
        sitePosts.length > 0 ? (
          <ul class="space-y-3">
            {sitePosts.map((post) => (
              <li>
                <a
                  href={getBlogPath(post)}
                  class="group block rounded-lg border border-stone-200 bg-stone-100/50 p-5 dark:border-stone-800 dark:bg-stone-900/50"
                >
                  <div class="mb-3 flex flex-wrap items-center gap-3">
                    <span class="font-mono text-xs uppercase tracking-wider text-stone-500">
                      {formatDate(post.data.date)}
                    </span>
                    <PostMetaBadges
                      project={post.data.project}
                      kind={post.data.kind}
                    />
                  </div>
                  <h3 class="text-lg font-semibold text-stone-900 transition-colors duration-200 group-hover:text-stone-700 dark:text-stone-100 dark:group-hover:text-stone-300">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                    {post.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">
            공개된 site note가 아직 없습니다.
          </p>
        )
      }
    </section>

    <section>
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Latest
      </h2>
      <ul>
        {
          posts.map((post) => (
            <li class="border-b border-stone-200 dark:border-stone-800 py-6 first:pt-0 last:border-b-0 last:pb-0">
              <a href={getBlogPath(post)} class="group block">
                <div class="mb-3 flex flex-wrap items-center gap-3">
                  <span class="font-mono text-xs uppercase tracking-wider text-stone-500">
                    {formatDate(post.data.date)}
                  </span>
                  <PostMetaBadges
                    project={post.data.project}
                    kind={post.data.kind}
                  />
                </div>
                <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-100 transition-colors duration-200 group-hover:text-stone-700 dark:group-hover:text-stone-300 md:text-2xl">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="mt-2 text-base leading-relaxed text-stone-600 dark:text-stone-400">
                    {post.data.description}
                  </p>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
