---
import PostListItem from '../../components/PostListItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getBlogPath,
  getPublishedBlogPosts,
  getSeriesGroups,
  getSitePosts,
  getStudyPosts,
} from '../../lib/blog';

const RECENT_POSTS_LIMIT = 5;

const posts = await getPublishedBlogPosts();
const seriesGroups = getSeriesGroups(posts);
const studyPosts = getStudyPosts(posts);
const sitePosts = getSitePosts(posts);
const recentPosts = posts.slice(0, RECENT_POSTS_LIMIT);
const getSeriesPath = (series: (typeof seriesGroups)[number]['series']) =>
  series.project
    ? `/projects/${series.project}/`
    : `/blog/series/${series.id}/`;
---

<BaseLayout
  title="Blog — jwsung91"
  description="Writing about systems, robotics, and software architecture."
>
  <main class="page-layout">
    <section class="mb-16">
      <h1
        class="mb-3 text-3xl font-bold text-stone-900 dark:text-stone-100 md:text-4xl"
      >
        Writing
      </h1>
      <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">
        프로젝트와 개인 학습을 기록하는 기술 문서 아카이브입니다.
      </p>
    </section>

    <section class="mb-16">
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Series
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          seriesGroups.map((group) => {
            const firstPost = group.posts[0];

            return (
              <article class="rounded-lg border border-stone-200 bg-stone-100/50 p-5 dark:border-stone-800 dark:bg-stone-900/50">
                <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-100">
                  {group.series.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                  {group.posts.length}개의 연재 글이 있습니다.
                </p>
                <a
                  href={getSeriesPath(group.series)}
                  class="mt-4 inline-block font-mono text-sm text-azure-600 dark:text-azure-400 hover:underline"
                >
                  series →
                </a>
                {firstPost && (
                  <a
                    href={getBlogPath(firstPost)}
                    class="mt-2 block text-sm text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
                  >
                    시작하기: {firstPost.data.title}
                  </a>
                )}
              </article>
            );
          })
        }
      </div>
    </section>

    {
      studyPosts.length > 0 && (
        <section class="mb-16">
          <h2 class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500">
            Study Notes
          </h2>
          <ul class="space-y-3">
            {studyPosts.map((post) => (
              <li>
                <PostListItem post={post} variant="card" headingLevel="h3" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mb-16">
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Site Notes
      </h2>
      {
        sitePosts.length > 0 ? (
          <ul class="space-y-3">
            {sitePosts.map((post) => (
              <li>
                <PostListItem post={post} variant="card" headingLevel="h3" />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">
            공개된 site note가 아직 없습니다.
          </p>
        )
      }
    </section>

    <section>
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Latest
      </h2>
      <ul>
        {
          recentPosts.map((post) => (
            <li class="border-b border-stone-200 dark:border-stone-800 py-6 first:pt-0 last:border-b-0 last:pb-0">
              <PostListItem post={post} variant="row" headingLevel="h2" />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
