---
import PostListItem from '../../../components/PostListItem.astro';
import TagFilter from '../../../components/TagFilter.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  filterPostsByTagSlug,
  getBlogTagSummaries,
  getPublishedBlogPosts,
} from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();
  const tagSummaries = getBlogTagSummaries(posts);

  return tagSummaries.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tagLabel: tag.tag,
      tagSlug: tag.slug,
      tagSummaries,
      posts: filterPostsByTagSlug(posts, tag.slug),
    },
  }));
}

const { tagLabel, tagSlug, tagSummaries, posts } = Astro.props;
const pageTitle = `Tag: ${tagLabel} — jwsung91`;
const pageDescription = `${tagLabel} 태그가 달린 블로그 글 목록입니다.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="page-layout">
    <section class="mb-10">
      <p class="mb-3 font-mono text-xs uppercase tracking-wider text-stone-500">
        Tag
      </p>
      <h1
        class="mb-3 text-3xl font-bold text-stone-900 dark:text-stone-100 md:text-4xl"
      >
        {tagLabel}
      </h1>
      <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">
        {posts.length} posts tagged {tagLabel}.
      </p>
    </section>

    <TagFilter tags={tagSummaries} activeTag={tagSlug} />

    <section>
      <h2
        class="mb-6 font-mono text-xs uppercase tracking-wider text-stone-500"
      >
        Posts
      </h2>
      {
        posts.length > 0 ? (
          <ul>
            {posts.map((post) => (
              <li class="border-b border-stone-200 py-6 first:pt-0 last:border-b-0 last:pb-0 dark:border-stone-800">
                <PostListItem post={post} variant="row" headingLevel="h2" />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">
            이 태그의 글이 아직 없습니다.
          </p>
        )
      }
    </section>
  </main>
</BaseLayout>
