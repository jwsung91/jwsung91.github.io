---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutEntry = await getEntry('about', 'about');
const { Content: AboutContent } = await render(aboutEntry);
---

<BaseLayout
  title="About — jwsung91"
  description="Background, experience, and contact information for Jinwoo Sung."
>
  <main class="page-layout">
    <article
      class="page-content prose max-w-none w-full font-serif dark:prose-invert prose-stone prose-headings:text-stone-800 dark:prose-headings:text-stone-200 prose-p:text-stone-800 dark:prose-p:text-stone-200 prose-li:text-stone-800 dark:prose-li:text-stone-200 prose-strong:text-stone-900 dark:prose-strong:text-stone-100 prose-a:text-azure-600 dark:prose-a:text-azure-400 prose-a:no-underline hover:prose-a:underline"
    >
      <AboutContent />
    </article>
  </main>
</BaseLayout>
