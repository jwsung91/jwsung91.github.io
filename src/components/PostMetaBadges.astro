---
import {
  kindLabels,
  projectLabels,
  topicLabels,
  type BlogKind,
  type BlogProject,
  type BlogTopic,
} from '../lib/blog';

interface Props {
  project?: BlogProject;
  kind: BlogKind;
  topic?: BlogTopic;
}

const { project, kind, topic } = Astro.props;

const badgeClass =
  'inline-flex rounded px-2 py-1 font-mono text-xs uppercase tracking-wider';

const kindStyles: Record<BlogKind, string> = {
  design:
    'bg-coral-500/15 text-coral-700 dark:bg-coral-500/15 dark:text-coral-400',
  implementation:
    'bg-green-100/50 text-green-700 dark:bg-green-900/50 dark:text-green-300',
  release:
    'bg-amber-100/50 text-amber-700 dark:bg-amber-900/50 dark:text-amber-300',
  retrospective:
    'bg-purple-100/50 text-purple-700 dark:bg-purple-900/50 dark:text-purple-300',
  study: 'bg-cyan-100/50 text-cyan-700 dark:bg-cyan-900/50 dark:text-cyan-300',
  note: 'bg-stone-200 text-stone-600 dark:bg-stone-800 dark:text-stone-400',
};
---

{
  project && (
    <span
      class={`${badgeClass} bg-stone-900 text-white dark:bg-stone-100 dark:text-zinc-950`}
    >
      {projectLabels[project]}
    </span>
  )
}
<span class={`${badgeClass} ${kindStyles[kind]}`}>{kindLabels[kind]}</span>
{
  topic && (
    <span
      class={`${badgeClass} bg-stone-100 text-stone-600 dark:bg-stone-900 dark:text-stone-400`}
    >
      {topicLabels[topic]}
    </span>
  )
}
