---
const provider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER ?? 'none';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const isProduction = import.meta.env.PROD;
const gaScript = gaMeasurementId
  ? `
window.dataLayer = window.dataLayer || [];
function gtag() {
  window.dataLayer.push(arguments);
}
gtag('js', new Date());
gtag('config', ${JSON.stringify(gaMeasurementId)});
`
  : '';
---

{
  isProduction && provider === 'plausible' && plausibleDomain && (
    <script
      defer
      data-domain={plausibleDomain}
      src="https://plausible.io/js/script.js"
    />
  )
}

{
  isProduction && provider === 'ga4' && gaMeasurementId && (
    <>
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
      />
      <script is:inline set:html={gaScript} />
    </>
  )
}
