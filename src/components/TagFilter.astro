---
import type { BlogTagSummary } from '../lib/blog';
import { getTagPath } from '../lib/blog';

interface Props {
  tags: BlogTagSummary[];
  activeTag?: string;
}

const { tags, activeTag } = Astro.props;

const baseClass =
  'inline-flex items-center rounded-full border px-3 py-1.5 font-mono text-xs transition-colors duration-200';
const inactiveClass =
  'border-stone-200 text-stone-600 hover:border-stone-400 hover:text-stone-900 dark:border-stone-800 dark:text-stone-400 dark:hover:border-stone-600 dark:hover:text-stone-100';
const activeClass =
  'border-stone-900 bg-stone-900 text-white dark:border-stone-100 dark:bg-stone-100 dark:text-zinc-950';
---

<nav class="mb-12" aria-label="Blog filters">
  <div class="flex flex-wrap items-center gap-2">
    <a
      class={`${baseClass} ${activeTag ? inactiveClass : activeClass}`}
      href="/blog/"
      aria-current={activeTag ? undefined : 'page'}
    >
      All
    </a>
    {
      tags.map((tag) => {
        const isActive = activeTag === tag.slug;

        return (
          <a
            class={`${baseClass} ${isActive ? activeClass : inactiveClass}`}
            href={getTagPath(tag.tag)}
            aria-current={isActive ? 'page' : undefined}
          >
            {tag.tag}
          </a>
        );
      })
    }
  </div>
</nav>
