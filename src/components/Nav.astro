---
const pathname = Astro.url.pathname.endsWith('/') && Astro.url.pathname !== '/'
  ? Astro.url.pathname.slice(0, -1)
  : Astro.url.pathname;

const items = [
  { label: 'About', href: '/about', key: 'about' },
  { label: 'Now', href: '/now', key: 'now' },
  { label: 'Projects', href: '/#projects', key: 'projects' },
  { label: 'Blog', href: '/blog', key: 'blog' },
  { label: 'AI Curator', href: 'https://jwsung91.github.io/ai-curator/', key: 'ai-curator', external: true },
];

const isRouteActive = (key: string) => {
  if (key === 'blog') {
    return pathname === '/blog' || pathname.startsWith('/blog/');
  }

  if (key === 'about') {
    return pathname === '/about';
  }

  if (key === 'now') {
    return pathname === '/now';
  }

  return false;
};
---

<header class="sticky top-0 z-50 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-2xl items-center justify-between px-6 md:px-8">
    <a
      href="/"
      class="font-mono text-sm font-semibold text-zinc-600 dark:text-zinc-400 transition-colors duration-200 hover:text-zinc-900 dark:hover:text-zinc-100"
    >
      Jinwoo Sung
    </a>

    <div class="flex items-center gap-4">
      <nav class="hidden items-center gap-6 text-sm font-mono md:flex" aria-label="Primary">
        {items.map((item) => {
          const active = isRouteActive(item.key);

          return (
            <a
              href={item.href}
              data-nav-item={item.key}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class:list={[
                'relative pb-1 text-zinc-600 dark:text-zinc-400 transition-colors duration-200 hover:text-zinc-900 dark:hover:text-zinc-100',
                active && 'text-zinc-900 dark:text-zinc-100',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
              <span
                data-nav-underline={item.key}
                class:list={[
                  'pointer-events-none absolute inset-x-0 -bottom-[18px] h-px bg-zinc-900 dark:bg-zinc-100',
                  active ? 'block' : 'hidden',
                ]}
              />
            </a>
          );
        })}
      </nav>

      <button
        id="theme-toggle"
        type="button"
        class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors"
        aria-label="Toggle theme"
      >
        <svg id="theme-toggle-light-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-toggle-dark-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <button
        type="button"
        class="font-mono text-sm text-zinc-600 dark:text-zinc-400 transition-colors duration-200 hover:text-zinc-900 dark:hover:text-zinc-100 md:hidden"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Menu
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="fixed inset-0 top-14 z-40 hidden bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md md:hidden"
    data-nav-overlay
  >
    <div class="mx-auto border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-6 py-6">
      <nav class="mx-auto flex max-w-2xl flex-col gap-4 text-base font-mono" aria-label="Mobile Primary">
        {items.map((item) => {
          const active = isRouteActive(item.key);

          return (
            <a
              href={item.href}
              data-mobile-nav-item={item.key}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class:list={[
                'border-b border-zinc-200 dark:border-zinc-800 pb-4 text-zinc-600 dark:text-zinc-400 transition-colors duration-200 hover:text-zinc-900 dark:hover:text-zinc-100',
                active && 'text-zinc-900 dark:text-zinc-100',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>
  </div>
</header>

<script>
  const setupNav = () => {
    const toggle = document.querySelector('[data-nav-toggle]');
    const overlay = document.querySelector('[data-nav-overlay]');
    const themeToggleBtn = document.getElementById('theme-toggle');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIcon = document.getElementById('theme-toggle-light-icon');

    if (themeToggleBtn) {
      if (document.documentElement.classList.contains('dark')) {
        darkIcon?.classList.remove('hidden');
      } else {
        lightIcon?.classList.remove('hidden');
      }

      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
          darkIcon?.classList.add('hidden');
          lightIcon?.classList.remove('hidden');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
          lightIcon?.classList.add('hidden');
          darkIcon?.classList.remove('hidden');
        }
      });

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          if (e.matches) {
            document.documentElement.classList.add('dark');
            lightIcon?.classList.add('hidden');
            darkIcon?.classList.remove('hidden');
          } else {
            document.documentElement.classList.remove('dark');
            darkIcon?.classList.add('hidden');
            lightIcon?.classList.remove('hidden');
          }
        }
      });
    }

    if (toggle instanceof HTMLButtonElement && overlay instanceof HTMLElement) {
      const closeMenu = () => {
        overlay.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      };

      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        overlay.classList.toggle('hidden', isOpen);
      });

      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) {
          closeMenu();
        }
      });

      overlay.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }

    if (window.location.pathname !== '/') {
      return;
    }

    const desktopLinks = Array.from(document.querySelectorAll('[data-nav-item]'));
    const mobileLinks = Array.from(document.querySelectorAll('[data-mobile-nav-item]'));
    const underlines = Array.from(document.querySelectorAll('[data-nav-underline]'));
    const sections = ['projects']
      .map((key) => ({ key, element: document.getElementById(key) }))
      .filter((section) => section.element instanceof HTMLElement);

    const applyAnchorState = (activeKey) => {
      desktopLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-item') === activeKey;
        link.classList.toggle('text-zinc-900', isActive);
        link.classList.toggle('dark:text-zinc-100', isActive);
        link.classList.toggle('text-zinc-600', !isActive);
        link.classList.toggle('dark:text-zinc-400', !isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      mobileLinks.forEach((link) => {
        const isActive = link.getAttribute('data-mobile-nav-item') === activeKey;
        link.classList.toggle('text-zinc-900', isActive);
        link.classList.toggle('dark:text-zinc-100', isActive);
        link.classList.toggle('text-zinc-600', !isActive);
        link.classList.toggle('dark:text-zinc-400', !isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      underlines.forEach((underline) => {
        const isActive = underline.getAttribute('data-nav-underline') === activeKey;
        underline.classList.toggle('hidden', !isActive);
        underline.classList.toggle('block', isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible) {
          applyAnchorState(visible.target.id);
          return;
        }

        if (window.scrollY < 120) {
          applyAnchorState(null);
        }
      },
      {
        rootMargin: '-80px 0px -45% 0px',
        threshold: [0.2, 0.4, 0.6],
      }
    );

    sections.forEach((section) => observer.observe(section.element));
    applyAnchorState(window.location.hash.replace('#', '') || null);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNav, { once: true });
  } else {
    setupNav();
  }
</script>