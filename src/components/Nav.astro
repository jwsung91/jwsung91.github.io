---
const pathname = Astro.url.pathname.endsWith('/') && Astro.url.pathname !== '/'
  ? Astro.url.pathname.slice(0, -1)
  : Astro.url.pathname;

const items = [
  { label: 'About', href: '/about', key: 'about' },
  { label: 'Now', href: '/#now', key: 'now' },
  { label: 'Projects', href: '/#projects', key: 'projects' },
  { label: 'Blog', href: '/blog', key: 'blog' },
];

const isRouteActive = (key: string) => {
  if (key === 'blog') {
    return pathname === '/blog' || pathname.startsWith('/blog/');
  }

  if (key === 'about') {
    return pathname === '/about';
  }

  return false;
};
---

<header class="sticky top-0 z-50 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-2xl items-center justify-between px-6 md:px-8">
    <a
      href="/"
      class="font-mono text-sm font-semibold text-zinc-400 transition-colors duration-200 hover:text-zinc-100"
    >
      Jinwoo Sung
    </a>

    <nav class="hidden items-center gap-6 text-sm font-mono md:flex" aria-label="Primary">
      {items.map((item) => {
        const active = isRouteActive(item.key);

        return (
          <a
            href={item.href}
            data-nav-item={item.key}
            class:list={[
              'relative pb-1 text-zinc-400 transition-colors duration-200 hover:text-zinc-100',
              active && 'text-zinc-100',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
            <span
              data-nav-underline={item.key}
              class:list={[
                'pointer-events-none absolute inset-x-0 -bottom-[18px] h-px bg-zinc-100',
                active ? 'block' : 'hidden',
              ]}
            />
          </a>
        );
      })}
    </nav>

    <button
      type="button"
      class="font-mono text-sm text-zinc-400 transition-colors duration-200 hover:text-zinc-100 md:hidden"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      Menu
    </button>
  </div>

  <div
    id="mobile-nav"
    class="fixed inset-0 top-14 z-40 hidden bg-zinc-950/95 backdrop-blur-md md:hidden"
    data-nav-overlay
  >
    <div class="mx-auto border-b border-zinc-800 bg-zinc-950 px-6 py-6">
      <nav class="mx-auto flex max-w-2xl flex-col gap-4 text-base font-mono" aria-label="Mobile Primary">
        {items.map((item) => {
          const active = isRouteActive(item.key);

          return (
            <a
              href={item.href}
              data-mobile-nav-item={item.key}
              class:list={[
                'border-b border-zinc-800 pb-4 text-zinc-400 transition-colors duration-200 hover:text-zinc-100',
                active && 'text-zinc-100',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>
  </div>
</header>

<script>
  const setupNav = () => {
    const toggle = document.querySelector('[data-nav-toggle]');
    const overlay = document.querySelector('[data-nav-overlay]');

    if (toggle instanceof HTMLButtonElement && overlay instanceof HTMLElement) {
      const closeMenu = () => {
        overlay.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      };

      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        overlay.classList.toggle('hidden', isOpen);
      });

      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) {
          closeMenu();
        }
      });

      overlay.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }

    if (window.location.pathname !== '/') {
      return;
    }

    const desktopLinks = Array.from(document.querySelectorAll('[data-nav-item]'));
    const mobileLinks = Array.from(document.querySelectorAll('[data-mobile-nav-item]'));
    const underlines = Array.from(document.querySelectorAll('[data-nav-underline]'));
    const sections = ['now', 'projects']
      .map((key) => ({ key, element: document.getElementById(key) }))
      .filter((section) => section.element instanceof HTMLElement);

    const applyAnchorState = (activeKey) => {
      desktopLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-item') === activeKey;
        link.classList.toggle('text-zinc-100', isActive);
        link.classList.toggle('text-zinc-400', !isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      mobileLinks.forEach((link) => {
        const isActive = link.getAttribute('data-mobile-nav-item') === activeKey;
        link.classList.toggle('text-zinc-100', isActive);
        link.classList.toggle('text-zinc-400', !isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      underlines.forEach((underline) => {
        const isActive = underline.getAttribute('data-nav-underline') === activeKey;
        underline.classList.toggle('hidden', !isActive);
        underline.classList.toggle('block', isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible) {
          applyAnchorState(visible.target.id);
          return;
        }

        if (window.scrollY < 120) {
          applyAnchorState(null);
        }
      },
      {
        rootMargin: '-80px 0px -45% 0px',
        threshold: [0.2, 0.4, 0.6],
      }
    );

    sections.forEach((section) => observer.observe(section.element));
    applyAnchorState(window.location.hash.replace('#', '') || null);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNav, { once: true });
  } else {
    setupNav();
  }
</script>
