---
import type { CollectionEntry } from 'astro:content';
import { getBlogPath } from '../lib/blog';

interface Props {
  title: string;
  current: number;
  total: number;
  previousPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { title, current, total, previousPost, nextPost } = Astro.props;
const nextPostClass = previousPost
  ? 'group block sm:text-right'
  : 'group block sm:text-right sm:col-start-2';
---

<nav
  class="mt-12 border-y border-stone-200 py-6 dark:border-stone-800"
  aria-label={`${title} series navigation`}
>
  <p class="mb-5 font-mono text-sm text-stone-500">
    {title}
    {current} / {total}
  </p>

  <div class="grid gap-5 sm:grid-cols-2">
    {
      previousPost && (
        <a href={getBlogPath(previousPost)} class="group block">
          <span class="font-mono text-xs uppercase tracking-wider text-stone-500">
            ← 이전 글
          </span>
          <span class="mt-2 block text-base font-semibold text-stone-900 transition-colors duration-200 group-hover:text-stone-700 dark:text-stone-100 dark:group-hover:text-stone-300">
            {previousPost.data.title}
          </span>
        </a>
      )
    }

    {
      nextPost && (
        <a href={getBlogPath(nextPost)} class={nextPostClass}>
          <span class="font-mono text-xs uppercase tracking-wider text-stone-500">
            다음 글 →
          </span>
          <span class="mt-2 block text-base font-semibold text-stone-900 transition-colors duration-200 group-hover:text-stone-700 dark:text-stone-100 dark:group-hover:text-stone-300">
            {nextPost.data.title}
          </span>
        </a>
      )
    }
  </div>
</nav>
