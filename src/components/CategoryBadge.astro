---
type Category = 'devlog' | 'study' | 'adr' | 'note';

interface Props {
  category: Category;
}

const { category } = Astro.props;

const styles: Record<Category, string> = {
  devlog:
    'bg-green-100/50 text-green-700 dark:bg-green-900/50 dark:text-green-300',
  study: 'bg-blue-100/50 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300',
  adr: 'bg-purple-100/50 text-purple-700 dark:bg-purple-900/50 dark:text-purple-300',
  note: 'bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400',
};
---

<span
  class={`inline-flex rounded px-2 py-1 font-mono text-xs uppercase tracking-wider ${styles[category]}`}
>
  {category}
</span>
