---
import type { CollectionEntry } from 'astro:content';
import { getBlogPath } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  firstPost: CollectionEntry<'blog'>;
}

const { title, description, firstPost } = Astro.props;
---

<article class="rounded-lg border border-zinc-200 bg-zinc-100/50 p-5 dark:border-zinc-800 dark:bg-zinc-900/50">
  <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>
  <a href={getBlogPath(firstPost)} class="mt-4 inline-block font-mono text-sm text-blue-400 hover:underline">
    시작하기: {firstPost.data.title}
  </a>
</article>
