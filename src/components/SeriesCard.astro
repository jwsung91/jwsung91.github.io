---
import type { CollectionEntry } from 'astro:content';
import { getBlogPath } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  firstPost: CollectionEntry<'blog'>;
}

const { title, description, firstPost } = Astro.props;
---

<article
  class="rounded-lg border border-stone-200 bg-stone-100/50 p-5 dark:border-stone-800 dark:bg-stone-900/50"
>
  <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-100">
    {title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
    {description}
  </p>
  <a
    href={getBlogPath(firstPost)}
    class="mt-4 inline-block font-mono text-sm text-coral-600 dark:text-coral-400 hover:underline"
  >
    시작하기: {firstPost.data.title}
  </a>
</article>
